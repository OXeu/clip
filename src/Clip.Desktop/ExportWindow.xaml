<Window x:Class="Clip.Desktop.ExportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出视频 · Clip" Width="520" Height="700" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="让好片段，成为作品。" FontSize="23" FontWeight="SemiBold" />
      <TextBlock Text="仅拼合时间轴中保留的片段 · MP4 / H.264" Style="{StaticResource MutedText}" Margin="0,10,0,24" />
      <TextBlock Text="画面质量" Margin="0,0,0,7" />
      <ComboBox x:Name="QualityBox" SelectedIndex="0">
        <ComboBoxItem Content="原画 · 原分辨率 / 高质量重编码" /><ComboBoxItem Content="高清 · CQ / CRF 19" />
        <ComboBoxItem Content="均衡 · CQ / CRF 23" /><ComboBoxItem Content="小体积 · CQ / CRF 28" />
      </ComboBox>
      <TextBlock Text="输出尺寸" Margin="0,17,0,7" />
      <ComboBox x:Name="SizeBox" SelectedIndex="0" SelectionChanged="SizeSelectionChanged">
        <ComboBoxItem Content="跟随源视频" /><ComboBoxItem Content="1080p · 1920 × 1080" /><ComboBoxItem Content="720p · 1280 × 720" />
        <ComboBoxItem Content="2160p · 3840 × 2160" /><ComboBoxItem Content="自定义宽高" />
      </ComboBox>
      <Grid x:Name="DimensionsPanel" Margin="0,10,0,0" IsEnabled="False">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <TextBox x:Name="WidthBox" AutomationProperties.Name="输出宽度" />
        <TextBlock Grid.Column="1" Text="×" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <TextBox x:Name="HeightBox" Grid.Column="2" AutomationProperties.Name="输出高度" />
      </Grid>
      <TextBlock Text="保持画面比例，尺寸不匹配时补黑边。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0" />
      <TextBlock Text="视频编码器" Margin="0,17,0,7" />
      <ComboBox x:Name="EncoderBox" SelectedIndex="0">
        <ComboBoxItem x:Name="NvidiaItem" Content="NVIDIA NVENC · 硬件编码" /><ComboBoxItem Content="CPU · H.264 软件编码" />
      </ComboBox>
      <CheckBox x:Name="HardwareDecodeBox" Content="使用 NVIDIA NVDEC / CUDA 硬件解码" Margin="0,16,0,0" />
      <TextBlock x:Name="HardwareHint" Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0" />
      <Border Background="{StaticResource SurfaceBrush}" Padding="12" CornerRadius="5" Margin="0,18,0,0">
        <TextBlock Text="“原画”保留原分辨率，以高质量重新编码。精确切割不受关键帧限制，但不等同于无损复制。文件大小由画面内容和质量决定。" Style="{StaticResource MutedText}" FontSize="11" />
      </Border>
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="取消" IsCancel="True" Margin="0,0,8,0" />
      <Button Content="选择位置并导出 ↗" Style="{StaticResource AccentButton}" Click="ConfirmClick" IsDefault="True" />
    </StackPanel>
  </Grid>
</Window>
