<Window x:Class="Clip.Desktop.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Clip.Desktop"
        Title="导出视频" Style="{StaticResource DialogWindow}" Width="540" Height="690"
        MinWidth="500" MinHeight="560" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" PreviewKeyDown="ExportPreviewKeyDown">
  <Grid x:Name="DialogRoot" Background="{DynamicResource ColorNeutralBackground3}">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Margin="24,24,24,20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock Text="导出视频" Style="{StaticResource DialogTitle}" VerticalAlignment="Center" />
      <Border Grid.Column="1" Background="{DynamicResource ColorBrandBackground2}" CornerRadius="{StaticResource RadiusControl}" Padding="10,5" VerticalAlignment="Center">
        <TextBlock Text="MP4" Foreground="{DynamicResource ColorBrandForeground}" FontWeight="SemiBold" FontSize="12" />
      </Border>
    </Grid>
    <ScrollViewer x:Name="ExportScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,0,24,24">
        <Border Style="{StaticResource SubtleSurface}" Margin="0,0,0,24">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource ColorBrandBackground2}" Margin="0,0,12,0">
              <local:RemixIcon Kind="Film" Foreground="{DynamicResource ColorBrandForeground}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="SourceNameText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="SourceInfoText" Style="{StaticResource Caption}" Margin="0,4,0,0" />
            </StackPanel>
          </Grid>
        </Border>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <TextBlock Text="画面质量" Style="{StaticResource FieldLabel}" Margin="0" />
          <Button x:Name="QualityHelpButton" Style="{StaticResource QuietButton}" Content="?" Width="20" MinHeight="20" Padding="0" Margin="6,-2,0,-2"
                  Click="QualityHelpClick" ToolTip="查看画面质量说明" AutomationProperties.Name="了解画面质量" />
          <Popup x:Name="QualityHelp" PlacementTarget="{Binding ElementName=QualityHelpButton}" Placement="Bottom" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True">
            <Border Style="{StaticResource Surface}" Padding="14,10" MaxWidth="360">
              <TextBlock Text="{Binding Text, ElementName=QualityDescriptionText}" Style="{StaticResource SecondaryText}" />
            </Border>
          </Popup>
        </StackPanel>
        <ComboBox x:Name="QualityBox" SelectedIndex="0" MinHeight="36" HorizontalAlignment="Stretch" SelectionChanged="QualitySelectionChanged" AutomationProperties.Name="画面质量">
          <ComboBoxItem Content="原画 · 保留源分辨率" /><ComboBoxItem Content="高清" />
          <ComboBoxItem Content="均衡" /><ComboBoxItem Content="较小文件" />
        </ComboBox>
        <TextBlock x:Name="QualityDescriptionText" Visibility="Collapsed" />
        <TextBlock Text="输出尺寸" Style="{StaticResource FieldLabel}" Margin="0,24,0,8" />
        <ComboBox x:Name="SizeBox" SelectedIndex="0" MinHeight="36" HorizontalAlignment="Stretch" SelectionChanged="SizeSelectionChanged" AutomationProperties.Name="输出尺寸">
          <ComboBoxItem Content="跟随源视频" /><ComboBoxItem Content="1080p" /><ComboBoxItem Content="720p" />
          <ComboBoxItem Content="4K" /><ComboBoxItem Content="自定义尺寸" />
        </ComboBox>
        <Grid x:Name="DimensionsPanel" Margin="0,12,0,0" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="宽度 (px)" Style="{StaticResource Caption}" Margin="0,0,0,4" /><TextBox x:Name="WidthBox" MinHeight="36" TextChanged="DimensionsEdited" AutomationProperties.Name="输出宽度" /></StackPanel>
          <TextBlock Grid.Column="1" Text="×" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" />
          <StackPanel Grid.Column="2"><TextBlock Text="高度 (px)" Style="{StaticResource Caption}" Margin="0,0,0,4" /><TextBox x:Name="HeightBox" MinHeight="36" TextChanged="DimensionsEdited" AutomationProperties.Name="输出高度" /></StackPanel>
        </Grid>
        <TextBlock x:Name="SizeHintText" Style="{StaticResource Caption}" Margin="0,8,0,24" />
        <Expander x:Name="AdvancedExpander" Header="编码设置" IsExpanded="False" HorizontalAlignment="Stretch" Expanded="AdvancedExpanded">
          <StackPanel Margin="0,16,0,0">
            <TextBlock Text="视频编码器" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="EncoderBox" SelectedIndex="0" MinHeight="36" HorizontalAlignment="Stretch" AutomationProperties.Name="视频编码器">
              <ComboBoxItem x:Name="NvidiaItem" Content="NVIDIA NVENC · 硬件编码" /><ComboBoxItem Content="CPU · 软件编码" />
            </ComboBox>
            <TextBlock Text="视频 H.264 · 音频 AAC · 保持画面比例" Style="{StaticResource Caption}" Margin="0,16,0,0" />
          </StackPanel>
        </Expander>
        <Border x:Name="ValidationPanel" Visibility="Collapsed" Background="{DynamicResource ColorDangerBackground}" CornerRadius="{StaticResource RadiusControl}" Padding="12" Margin="0,16,0,0">
          <TextBlock x:Name="ValidationText" TextWrapping="Wrap" Foreground="{DynamicResource ColorDangerForeground}" AutomationProperties.LiveSetting="Assertive" />
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Style="{StaticResource DialogFooter}">
      <Grid>
        <TextBlock Text="本机处理" Style="{StaticResource Caption}" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="取消" Style="{StaticResource QuietButton}" IsCancel="True" Margin="0,0,8,0" />
          <Button Content="选择保存位置" Style="{StaticResource PrimaryButton}" Click="ConfirmClick" IsDefault="True" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
