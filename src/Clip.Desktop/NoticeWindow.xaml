<Window x:Class="Clip.Desktop.NoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示" Style="{StaticResource DialogWindow}" Width="520" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid x:Name="NoticeRoot" Background="{DynamicResource ColorNeutralBackground3}">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <TextBlock x:Name="Heading" Style="{StaticResource DialogTitle}" Margin="24,24,24,16" TextWrapping="Wrap" />
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="360" Margin="24,0,24,24">
      <TextBox x:Name="Message" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
               Foreground="{DynamicResource ColorNeutralForeground2}" Padding="0" MinHeight="0"
               AutomationProperties.Name="提示详情" VerticalScrollBarVisibility="Disabled">
        <TextBox.Template>
          <ControlTemplate TargetType="TextBox">
            <ScrollViewer x:Name="PART_ContentHost" />
          </ControlTemplate>
        </TextBox.Template>
      </TextBox>
    </ScrollViewer>
    <Border Grid.Row="2" Style="{StaticResource DialogFooter}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CancelAction" Style="{StaticResource QuietButton}" IsCancel="True" Margin="0,0,8,0" />
        <Button x:Name="ConfirmAction" Style="{StaticResource PrimaryButton}" Click="ConfirmClick" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
