<Window x:Class="Clip.Desktop.ClipSpeedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义片段倍速" Style="{StaticResource DialogWindow}" Width="440" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid x:Name="SpeedRoot" Background="{DynamicResource ColorNeutralBackground3}">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="24">
      <TextBlock Text="自定义片段倍速" Style="{StaticResource DialogTitle}" Margin="0,0,0,24" />
      <TextBlock Text="倍速" Style="{StaticResource FieldLabel}" />
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBox x:Name="SpeedInput" AutomationProperties.Name="片段倍速" ToolTip="输入 0.1 到 8 之间的任意小数" />
        <TextBlock Grid.Column="1" Text="×" Style="{StaticResource TimeValue}" FontSize="16" Margin="10,0,2,0" VerticalAlignment="Center" />
      </Grid>
      <TextBlock Text="支持 0.1×–8×；只改变当前选中的片段。" Style="{StaticResource Caption}" Margin="0,8,0,0" />
      <TextBlock x:Name="ValidationText" Foreground="{DynamicResource ColorDangerForeground}" Text="请输入 0.1–8 之间的倍速。"
                 Visibility="Collapsed" Margin="0,8,0,0" AutomationProperties.LiveSetting="Assertive" />
    </StackPanel>
    <Border Grid.Row="1" Style="{StaticResource DialogFooter}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取消" Style="{StaticResource QuietButton}" IsCancel="True" Margin="0,0,8,0" />
        <Button x:Name="ApplySpeedButton" Content="应用倍速" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="ApplyClick" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
