<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Preserve Microsoft's Fluent focus, hover, disabled, keyboard and popup templates. -->
  <Style x:Key="ClipWindow" TargetType="Window">
    <Setter Property="Background" Value="{StaticResource ColorNeutralBackground3}" />
    <Setter Property="Foreground" Value="{StaticResource ColorNeutralForeground1}" />
    <Setter Property="FontFamily" Value="{StaticResource FontFamilyBase}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>
  <Style x:Key="Surface" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource ColorNeutralBackground1}" />
    <Setter Property="BorderBrush" Value="{StaticResource ColorNeutralStroke2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSurface}" />
  </Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSubtitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource ColorNeutralForeground1}" />
  </Style>
  <Style x:Key="SecondaryText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource ColorNeutralForeground3}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="20" />
  </Style>
  <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="LineHeight" Value="18" />
  </Style>
  <Style x:Key="CommandButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
    <Setter Property="Padding" Value="{StaticResource ControlPadding}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
    <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource CommandButton}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
    <Setter Property="Width" Value="{StaticResource ControlHeight}" />
    <Setter Property="Padding" Value="8" />
  </Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style x:Key="TimeValue" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontFamilyMono}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="Foreground" Value="{StaticResource ColorNeutralForeground2}" />
  </Style>
</ResourceDictionary>
