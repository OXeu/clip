<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- 颜色由 UiTheme 提供；布局尺度对应 Peace 的控件、面板与工作区。 -->
  <FontFamily x:Key="FontFamilyBase">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
  <FontFamily x:Key="FontFamilyMono">Cascadia Mono, Consolas</FontFamily>
  <sys:Double x:Key="FontSizeCaption">12</sys:Double>
  <sys:Double x:Key="FontSizeBody">13</sys:Double>
  <sys:Double x:Key="FontSizeSubtitle">14</sys:Double>
  <sys:Double x:Key="FontSizeTitle">22</sys:Double>
  <sys:Double x:Key="FontSizeHero">30</sys:Double>
  <sys:Double x:Key="ControlHeight">36</sys:Double>
  <sys:Double x:Key="Space4">4</sys:Double>
  <sys:Double x:Key="Space8">8</sys:Double>
  <sys:Double x:Key="Space12">12</sys:Double>
  <sys:Double x:Key="Space16">16</sys:Double>
  <sys:Double x:Key="Space20">20</sys:Double>
  <sys:Double x:Key="Space24">24</sys:Double>
  <sys:Double x:Key="Space32">32</sys:Double>
  <Thickness x:Key="PagePadding">24</Thickness>
  <Thickness x:Key="PanelPadding">24</Thickness>
  <Thickness x:Key="ControlPadding">12,7</Thickness>
  <Thickness x:Key="FieldGap">0,8,0,0</Thickness>
  <Thickness x:Key="SectionGap">0,24,0,0</Thickness>
  <CornerRadius x:Key="RadiusControl">8</CornerRadius>
  <CornerRadius x:Key="RadiusSurface">12</CornerRadius>
  <CornerRadius x:Key="RadiusHero">16</CornerRadius>
  <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="PopupCornerRadius">12</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
  <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
  <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
  <Thickness x:Key="ComboBoxBorderThemeThickness">1</Thickness>
  <sys:Double x:Key="TimelineClipRadius">6</sys:Double>
</ResourceDictionary>
