<Window x:Class="Clip.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Clip.Desktop"
        Title="Clip" Style="{StaticResource ClipWindow}" Width="1360" Height="900"
        MinWidth="1000" MinHeight="740" WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" PreviewKeyDown="OnKeyDown" Closing="OnClosing">
  <Grid x:Name="WindowRoot" Background="{StaticResource ColorNeutralBackground3}">
    <Grid.RowDefinitions>
      <RowDefinition Height="64" /><RowDefinition Height="*" />
      <RowDefinition x:Name="TimelineRow" Height="0" /><RowDefinition Height="32" />
    </Grid.RowDefinitions>

    <Grid Margin="24,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Background="{StaticResource ColorBrandBackground}" CornerRadius="6" Width="32" Height="32" Margin="0,0,12,0">
          <TextBlock Text="C" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource ColorOnBrand}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="Clip" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Border Width="1" Height="20" Background="{StaticResource ColorNeutralStroke1}" Margin="24,0" />
      </StackPanel>
      <TextBlock x:Name="DocumentTitle" Grid.Column="1" Text="新建剪辑" Foreground="{StaticResource ColorNeutralForeground3}"
                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,24,0" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="ImportButton" Style="{StaticResource QuietButton}" Click="ImportClick" Visibility="Collapsed" Margin="0,0,8,0" ToolTip="更换视频 (Ctrl+O)">
          <StackPanel Orientation="Horizontal"><local:RemixIcon Kind="Import" Margin="0,0,8,0" /><TextBlock Text="更换视频" /></StackPanel>
        </Button>
        <Button x:Name="ExportButton" Style="{StaticResource PrimaryButton}" Click="ExportClick" Visibility="Collapsed" IsEnabled="False" Margin="0,0,12,0">
          <StackPanel Orientation="Horizontal"><local:RemixIcon Kind="Export" Margin="0,0,8,0" /><TextBlock Text="导出视频" /></StackPanel>
        </Button>
        <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Click="SettingsClick" ToolTip="设置" AutomationProperties.Name="设置">
          <local:RemixIcon Kind="Settings" />
          <Button.ContextMenu><ContextMenu>
            <MenuItem Header="资源管理器集成">
              <MenuItem Header="添加“使用 Clip 剪辑”右键菜单" Click="RegisterShellClick" />
              <MenuItem Header="移除右键菜单" Click="UnregisterShellClick" />
            </MenuItem>
            <MenuItem Header="高级设置">
              <MenuItem Header="选择 FFmpeg 目录…" Click="ChooseFfmpegClick" />
              <Separator />
              <MenuItem Header="重新检测 NVIDIA" Click="RetryNvidiaClick" />
              <MenuItem Header="NVIDIA 检测详情…" Click="NvidiaDiagnosticsClick" />
            </MenuItem>
          </ContextMenu></Button.ContextMenu>
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="24,0,24,16">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="SourceColumn" Width="0" /><ColumnDefinition x:Name="SourceGapColumn" Width="0" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border x:Name="SourcePane" Style="{StaticResource Surface}" Padding="{StaticResource PanelPadding}" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="素材" Style="{StaticResource SectionTitle}" Margin="0,0,0,16" />
            <Border Background="{StaticResource ColorNeutralBackground3}" CornerRadius="4" Height="108" ClipToBounds="True">
              <Image x:Name="Thumbnail" Stretch="UniformToFill" />
            </Border>
            <TextBlock x:Name="FileNameText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,4" />
            <TextBlock x:Name="SourceSummaryText" Style="{StaticResource Caption}" />
            <Expander x:Name="SourceDetailsExpander" Header="素材信息" Margin="0,16,0,0" IsExpanded="False" HorizontalAlignment="Stretch">
              <TextBlock x:Name="MediaDetailsText" Style="{StaticResource Caption}" Margin="0,8,0,0" />
            </Expander>
            <StackPanel x:Name="SelectionPanel" Visibility="Collapsed">
              <Border Height="1" Background="{StaticResource ColorNeutralStroke2}" Margin="0,24,0,20" />
              <TextBlock x:Name="SelectionText" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="片段时长" Style="{StaticResource Caption}" Margin="0,12,0,4" />
              <TextBlock x:Name="LengthText" FontFamily="{StaticResource FontFamilyMono}" FontSize="20" />
              <Expander x:Name="SelectionDetailsExpander" Header="时间信息" IsExpanded="False" Margin="0,16,0,0" HorizontalAlignment="Stretch">
                <StackPanel Margin="0,8,0,0">
                  <TextBlock Text="源视频入点" Style="{StaticResource Caption}" /><TextBlock x:Name="InText" Style="{StaticResource TimeValue}" Margin="0,4,0,12" />
                  <TextBlock Text="源视频出点" Style="{StaticResource Caption}" /><TextBlock x:Name="OutText" Style="{StaticResource TimeValue}" Margin="0,4,0,0" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Surface}" ClipToBounds="True">
        <Grid>
          <Grid.RowDefinitions><RowDefinition x:Name="PreviewHeaderRow" Height="0" /><RowDefinition Height="*" /><RowDefinition x:Name="PreviewFooterRow" Height="0" /></Grid.RowDefinitions>
          <Grid x:Name="PreviewHeader" Margin="20,0" Visibility="Collapsed">
            <TextBlock Text="预览" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
            <TextBlock x:Name="PreviewModeText" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
          <Grid x:Name="PreviewCanvas" Grid.Row="1" Background="{StaticResource ColorNeutralBackground1}">
            <MediaElement x:Name="Preview" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform" ScrubbingEnabled="True"
                          MediaOpened="PreviewOpened" MediaEnded="PreviewEnded" MediaFailed="PreviewFailed" Visibility="Hidden" />
            <Image x:Name="PreviewPoster" Stretch="Uniform" Visibility="Collapsed" />
            <StackPanel x:Name="EmptyPreview" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" Margin="24">
              <Border Width="72" Height="72" CornerRadius="{StaticResource RadiusHero}" Background="{StaticResource ColorBrandBackground2}" HorizontalAlignment="Center">
                <local:RemixIcon Kind="Film" Width="32" Height="32" Foreground="{StaticResource ColorBrandForeground}" HorizontalAlignment="Center" />
              </Border>
              <TextBlock Text="开始剪辑视频" FontSize="{StaticResource FontSizeHero}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,24,0,8" />
              <TextBlock Text="导入视频，在时间轴上留下需要的片段。" Style="{StaticResource SecondaryText}" TextAlignment="Center" />
              <Button x:Name="EmptyImportButton" Content="导入视频" Click="ImportClick" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Padding="24,8" Margin="0,24,0,12" />
              <TextBlock Text="也可以将视频拖到这里 · Ctrl+O" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel x:Name="NoSegmentsOverlay" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
              <TextBlock Text="时间轴为空" Foreground="{StaticResource ColorPreviewForeground}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <Button Content="撤销删除" Click="UndoClick" Style="{StaticResource CommandButton}" Margin="0,16,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
          <Grid x:Name="PreviewFooter" Grid.Row="2" Margin="20,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="PositionText" Text="00:00:00.000" FontFamily="{StaticResource FontFamilyMono}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="BackButton" Style="{StaticResource IconButton}" Click="StepBackClick" ToolTip="上一帧 (←)" AutomationProperties.Name="上一帧" IsEnabled="False" Margin="0,0,8,0"><local:RemixIcon Kind="Previous" /></Button>
              <Button x:Name="PlayButton" Style="{StaticResource CommandButton}" Click="PlayClick" ToolTip="播放 / 暂停 (Space)" AutomationProperties.Name="播放或暂停" Width="48" IsEnabled="False"><local:RemixIcon x:Name="PlayGlyph" Kind="Play" /></Button>
              <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Click="StepForwardClick" ToolTip="下一帧 (→)" AutomationProperties.Name="下一帧" IsEnabled="False" Margin="8,0,0,0"><local:RemixIcon Kind="Next" /></Button>
            </StackPanel>
            <TextBlock x:Name="TotalText" Grid.Column="2" Text="/ 00:00:00.000" Style="{StaticResource Caption}" FontFamily="{StaticResource FontFamilyMono}" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Border x:Name="TimelineRegion" Grid.Row="2" Style="{StaticResource Surface}" Margin="24,0,24,8" Visibility="Collapsed" ClipToBounds="True">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition Height="*" /><RowDefinition Height="32" /></Grid.RowDefinitions>
        <Grid Margin="16,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="时间轴" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="4,0,20,0" />
            <Button x:Name="SplitButton" Style="{StaticResource QuietButton}" Click="SplitClick" IsEnabled="False" ToolTip="在播放头处分割 (S)">
              <StackPanel Orientation="Horizontal"><local:RemixIcon Kind="Split" Margin="0,0,8,0" /><TextBlock Text="分割" /><TextBlock Text="S" Style="{StaticResource Caption}" Margin="12,1,0,0" /></StackPanel>
            </Button>
            <Button x:Name="DeleteButton" Style="{StaticResource QuietButton}" Click="DeleteClick" Visibility="Collapsed" ToolTip="删除选中片段 (Delete)" Margin="4,0,0,0">
              <StackPanel Orientation="Horizontal"><local:RemixIcon Kind="Delete" Margin="0,0,8,0" /><TextBlock Text="删除" /></StackPanel>
            </Button>
            <Border Height="20" Width="1" Background="{StaticResource ColorNeutralStroke2}" Margin="12,0" />
            <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Click="UndoClick" IsEnabled="False" ToolTip="撤销 (Ctrl+Z)" AutomationProperties.Name="撤销"><local:RemixIcon Kind="Undo" /></Button>
            <Button x:Name="RedoButton" Style="{StaticResource IconButton}" Click="RedoClick" IsEnabled="False" ToolTip="重做 (Ctrl+Y)" AutomationProperties.Name="重做"><local:RemixIcon Kind="Redo" /></Button>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="缩放" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Slider x:Name="ZoomSlider" Minimum="1" Maximum="20" Value="1" Width="100" VerticalAlignment="Center" ValueChanged="ZoomChanged" AutomationProperties.Name="时间轴缩放" />
            <Button Content="适应" Style="{StaticResource QuietButton}" Click="FitClick" Margin="12,0,0,0" />
          </StackPanel>
        </Grid>
        <ScrollViewer x:Name="TimelineScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" SizeChanged="TimelineSizeChanged">
          <local:TimelineControl x:Name="TimelineView" AutomationProperties.Name="视频时间轴，按 S 分割，Delete 删除选中片段" />
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="20,0">
          <TextBlock x:Name="TimelineSummaryText" Style="{StaticResource Caption}" VerticalAlignment="Center" />
          <TextBlock Text="点击片段选择 · 拖动标尺定位" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="3" Margin="24,0,24,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" Text="就绪" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
      <TextBlock x:Name="HardwareText" Visibility="Collapsed" />
      <ProgressBar x:Name="OperationProgress" Grid.Column="1" Width="160" Height="4" Maximum="1" Margin="16,0" Visibility="Collapsed" />
      <Button x:Name="CancelButton" Grid.Column="2" Content="取消" Style="{StaticResource QuietButton}" MinHeight="24" Padding="8,0" Click="CancelClick" Visibility="Collapsed" />
    </Grid>
  </Grid>
</Window>
