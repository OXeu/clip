<Window x:Class="Clip.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Clip.Desktop"
        Title="Clip · 轻量视频剪辑" Style="{StaticResource {x:Type Window}}" Width="1360" Height="880" MinWidth="1060" MinHeight="720" WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" PreviewKeyDown="OnKeyDown" Closing="OnClosing">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="*" MinHeight="250" /><RowDefinition Height="6" /><RowDefinition Height="264" MinHeight="220" /><RowDefinition Height="36" /></Grid.RowDefinitions>
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="22,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="◩" Foreground="{StaticResource AccentBrush}" FontSize="29" Margin="0,0,10,0" />
          <TextBlock Text="clip" FontSize="25" FontWeight="Bold" VerticalAlignment="Center" />
          <Border Width="1" Height="22" Background="{StaticResource BorderBrush}" Margin="24,0" />
          <TextBlock Text="轻量视频剪辑" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="SettingsButton" Content="设置 ▾" Click="SettingsClick" Margin="0,0,8,0">
            <Button.ContextMenu><ContextMenu>
              <MenuItem Header="选择 FFmpeg 所在目录…" Click="ChooseFfmpegClick" />
              <Separator />
              <MenuItem Header="添加资源管理器右键菜单" Click="RegisterShellClick" />
              <MenuItem Header="移除资源管理器右键菜单" Click="UnregisterShellClick" />
            </ContextMenu></Button.ContextMenu>
          </Button>
          <Button x:Name="ImportButton" Content="＋ 导入视频" Click="ImportClick" ToolTip="Ctrl + O，也可以拖入视频" Margin="0,0,8,0" />
          <Button x:Name="ExportButton" Content="导出视频  ↗" Style="{StaticResource AccentButton}" Click="ExportClick" IsEnabled="False" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="238" /></Grid.ColumnDefinitions>
      <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <TextBlock Text="素材库" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,20" />
          <StackPanel Grid.Row="1">
            <Border Background="#101214" CornerRadius="4" Height="106" Margin="0,0,0,12" ClipToBounds="True">
              <Grid><TextBlock Text="▻" Foreground="#69756C" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image x:Name="Thumbnail" Stretch="UniformToFill" /></Grid>
            </Border>
            <TextBlock x:Name="FileNameText" Text="还没有素材" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="MediaDetailsText" Text="导入或拖入一个视频文件。" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
          </StackPanel>
          <StackPanel Grid.Row="2">
            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16" />
            <TextBlock Text="源文件始终保留" Foreground="{StaticResource AccentBrush}" FontSize="12" />
            <TextBlock Text="分割与删除只改变时间轴，不会修改原始视频。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,7,0,0" />
          </StackPanel>
        </Grid>
        </ScrollViewer>
      </Border>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="*" /><RowDefinition Height="58" /></Grid.RowDefinitions>
        <DockPanel><TextBlock Text="预览" FontWeight="SemiBold" /><TextBlock x:Name="PreviewModeText" Text="适应画面" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" FontSize="11" /></DockPanel>
        <Border Grid.Row="1" Background="#08090A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
          <Grid>
            <MediaElement x:Name="Preview" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform" ScrubbingEnabled="True"
                          MediaOpened="PreviewOpened" MediaEnded="PreviewEnded" MediaFailed="PreviewFailed" />
            <StackPanel x:Name="EmptyPreview" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="从一个好片段开始。" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Text="将视频拖到这里，留下你想保留的部分。" Style="{StaticResource MutedText}" Margin="0,14,0,22" HorizontalAlignment="Center" />
              <Button Content="＋ 选择视频" Click="ImportClick" Style="{StaticResource AccentButton}" HorizontalAlignment="Center" />
              <TextBlock Text="MP4 · MOV · MKV · AVI · WEBM" Foreground="#727C84" FontSize="11" Margin="0,20,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Border>
        <Grid Grid.Row="2" VerticalAlignment="Center">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <TextBlock x:Name="PositionText" Text="00:00:00.000" FontFamily="Consolas" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="BackButton" Content="Ⅰ◀" Padding="10,7" Margin="0,0,6,0" Click="StepBackClick" ToolTip="上一帧 ←" IsEnabled="False" />
            <Button x:Name="PlayButton" Content="▶" Width="48" Padding="10,7" Click="PlayClick" ToolTip="播放 / 暂停 Space" IsEnabled="False" />
            <Button x:Name="ForwardButton" Content="▶Ⅰ" Padding="10,7" Margin="6,0,0,0" Click="StepForwardClick" ToolTip="下一帧 →" IsEnabled="False" />
          </StackPanel>
          <TextBlock x:Name="TotalText" Grid.Column="2" Text="/ 00:00:00.000" Foreground="{StaticResource MutedBrush}" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
      </Grid>
      <Border Grid.Column="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="17">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock Text="片段信息" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,22" />
          <TextBlock x:Name="SelectionText" Text="尚未选择片段" FontSize="17" Margin="0,0,0,17" />
          <TextBlock Text="源视频入点" Style="{StaticResource MutedText}" FontSize="11" /><TextBlock x:Name="InText" Text="—" FontFamily="Consolas" Margin="0,5,0,15" />
          <TextBlock Text="源视频出点" Style="{StaticResource MutedText}" FontSize="11" /><TextBlock x:Name="OutText" Text="—" FontFamily="Consolas" Margin="0,5,0,15" />
          <TextBlock Text="片段时长" Style="{StaticResource MutedText}" FontSize="11" /><TextBlock x:Name="LengthText" Text="—" FontFamily="Consolas" Margin="0,5,0,18" />
          <Button x:Name="DeleteButton" Content="删除选中片段   Delete" Click="DeleteClick" IsEnabled="False" />
          <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,22,0,15" />
          <TextBlock Text="S    在播放头处分割&#x0a;← →    逐帧移动&#x0a;Ctrl + Z    撤销编辑" Style="{StaticResource MutedText}" FontSize="12" LineHeight="24" />
        </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" ResizeDirection="Rows" />
    <Grid Grid.Row="3" Margin="14,10,14,0">
      <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /><RowDefinition Height="30" /></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <TextBlock Text="时间轴" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,20,0" />
          <Button x:Name="SplitButton" Content="分割  S" Click="SplitClick" Padding="12,6" IsEnabled="False" />
          <Button x:Name="UndoButton" Content="↶ 撤销" Click="UndoClick" Margin="6,0,0,0" Padding="12,6" IsEnabled="False" />
          <Button x:Name="RedoButton" Content="↷ 重做" Click="RedoClick" Margin="6,0,0,0" Padding="12,6" IsEnabled="False" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <TextBlock Text="缩放" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <Slider x:Name="ZoomSlider" Minimum="1" Maximum="20" Value="1" Width="100" VerticalAlignment="Center" ValueChanged="ZoomChanged" />
          <Button Content="适应" Click="FitClick" Padding="8,4" Margin="10,0,0,0" />
        </StackPanel>
      </DockPanel>
      <ScrollViewer x:Name="TimelineScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" SizeChanged="TimelineSizeChanged">
        <local:TimelineControl x:Name="TimelineView" />
      </ScrollViewer>
      <DockPanel Grid.Row="2" Margin="4,5,4,0"><TextBlock x:Name="TimelineSummaryText" Text="0 个片段" Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock Text="单击选择 · 拖动定位 · 右键删除" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="11" /></DockPanel>
    </Grid>
    <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,6">
      <DockPanel>
        <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="取消" Click="CancelClick" Padding="10,1" Margin="12,0,0,0" Visibility="Collapsed" />
        <ProgressBar x:Name="OperationProgress" DockPanel.Dock="Right" Width="140" Height="4" Maximum="1" Margin="14,0,0,0" Visibility="Collapsed" />
        <TextBlock x:Name="HardwareText" DockPanel.Dock="Right" Text="FFmpeg · 等待检测" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
        <TextBlock x:Name="StatusText" Text="就绪 · Ctrl + O 导入视频" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
