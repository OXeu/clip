<Window x:Class="Clip.Desktop.ClipNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="命名片段" Style="{StaticResource ClipWindow}" Width="420" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="24">
    <TextBlock Text="片段名称" Style="{StaticResource FieldLabel}" />
    <TextBox x:Name="NameInput" MinHeight="36" AutomationProperties.Name="片段名称" />
    <TextBlock Text="名称用于时间轴上的识别，不会修改源文件。" Style="{StaticResource Caption}" Margin="0,8,0,0" />
    <TextBlock x:Name="ValidationText" Foreground="{StaticResource ColorDangerForeground}" Text="请输入片段名称。"
               Visibility="Collapsed" Margin="0,8,0,0" AutomationProperties.LiveSetting="Assertive" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button Content="取消" Style="{StaticResource CommandButton}" IsCancel="True" Margin="0,0,8,0" />
      <Button x:Name="SaveNameButton" Content="保存" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="SaveClick" />
    </StackPanel>
  </StackPanel>
</Window>
