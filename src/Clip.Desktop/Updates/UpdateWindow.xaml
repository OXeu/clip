<Window x:Class="Clip.Desktop.Updates.UpdateWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Clip.Desktop"
        Title="检查更新" Style="{StaticResource DialogWindow}" Width="560" Height="610" MinWidth="500" MinHeight="450"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid x:Name="UpdateRoot" Background="{DynamicResource ColorNeutralBackground3}">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="24,24,24,20">
      <TextBlock Text="软件更新" Style="{StaticResource DialogTitle}" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,0,24,24">
        <Border Style="{StaticResource SubtleSurface}" Margin="0,0,0,24">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource ColorBrandBackground2}" Margin="0,0,12,0">
              <local:RemixIcon Kind="Upload" Foreground="{DynamicResource ColorBrandForeground}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="VersionText" FontWeight="SemiBold" />
              <TextBlock x:Name="ChannelText" Style="{StaticResource Caption}" Margin="0,4,0,0" />
            </StackPanel>
          </Grid>
        </Border>
        <TextBlock x:Name="_status" Text="正在检查更新…" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,16" AutomationProperties.LiveSetting="Polite" />
        <ProgressBar x:Name="_progress" Height="4" Minimum="0" Maximum="100" Margin="0,0,0,24" />
        <Border Style="{StaticResource SubtleSurface}" Margin="0,0,0,24">
          <TextBlock Text="更新完成后会自动重启。请先导出需要保留的片段。" Style="{StaticResource SecondaryText}" />
        </Border>
        <Expander Header="下载与访问设置">
          <StackPanel Margin="0,16,0,0">
            <TextBlock Text="GitHub 令牌（可选）" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="_token" Margin="0,0,0,16" AutomationProperties.Name="GitHub 令牌"
                         ToolTip="仅当前会话有效；留空沿用已配置令牌。私有仓库需要 Contents 和 Actions 只读权限。也可设置 CLIP_GITHUB_TOKEN 环境变量。" />
            <TextBlock Text="更新文件位置" Style="{StaticResource FieldLabel}" />
            <TextBlock x:Name="LocationText" Style="{StaticResource Caption}" />
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Style="{StaticResource DialogFooter}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="_cancel" Content="关闭" Style="{StaticResource QuietButton}" Margin="0,0,8,0" />
        <Button x:Name="_check" Content="检查更新" Style="{StaticResource CommandButton}" Margin="0,0,8,0" />
        <Button x:Name="_install" Content="更新并重启" Style="{StaticResource PrimaryButton}" IsEnabled="False" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
