{
  "name": "clip-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Clip 的静态网页版：WebCodecs 硬编为主，ffmpeg.wasm 兜底音频与兼容编码。",
  "scripts": {
    "prepare:ffmpeg": "node scripts/copy-ffmpeg-core.mjs",
    "predev": "npm run prepare:ffmpeg",
    "dev": "vite",
    "prebuild": "npm run prepare:ffmpeg",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/model.test.ts test/conformance.test.ts test/exporter.test.ts test/media-preparation.test.ts test/session.test.ts test/webcodecs-audio.test.ts",
    "test:e2e": "node --experimental-strip-types --test test/e2e.test.ts"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/core-mt": "^0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "mediabunny": "1.58.1",
    "mp4-muxer": "5.2.2",
    "mp4box": "2.4.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "playwright": "^1.63.0",
    "typescript": "5.9.3",
    "vite": "^8.3.0"
  }
}
